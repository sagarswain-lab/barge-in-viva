# --- LiveKit ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- Groq (LLM + STT, same key for both) ---
GROQ_API_KEY=your_groq_api_key
# llama-3.3-70b-versatile was decommissioned by Groq on 2026-08-16.
# openai/gpt-oss-120b is Groq's own recommended replacement. Change this
# if you want a different model without editing code.
GROQ_LLM_MODEL=openai/gpt-oss-120b

# --- Rime (TTS) ---
RIME_API_KEY=your_rime_api_key

# --- API server ---
# Comma-separated list of allowed frontend origins in production, e.g.
# https://barge-in-viva.vercel.app . Leave as * for local development.
FRONTEND_ORIGIN=*

# --- Session history storage ---
# Path to the shared SQLite file. Defaults to backend/sessions.db if unset.
# On Render's free tier this resets on every restart/redeploy — see
# backend/src/storage.py for details.
DATABASE_PATH=./sessions.db
